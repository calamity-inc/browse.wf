local input = [[https://www.warframe.com/promocode?code=BRUTEBROWN
https://www.warframe.com/promocode?code=BUGBREACH
https://www.warframe.com/promocode?code=CARRYTHEFIRE
https://www.warframe.com/promocode?code=EGIRLTENNO
https://www.warframe.com/promocode?code=KAKITAROS
https://www.warframe.com/promocode?code=LUCKYGOBLIN
https://www.warframe.com/promocode?code=MACTICS
https://www.warframe.com/promocode?code=PHERPLANCER
https://www.warframe.com/promocode?code=ROBOMYTHOS
https://www.warframe.com/promocode?code=SHIROKOSHA
https://www.warframe.com/promocode?code=TENNOBEN
https://www.warframe.com/promocode?code=VICEROYCYNDR
https://www.warframe.com/promocode?code=XIAOGUANG
https://www.warframe.com/promocode?code=ZLIDE
https://www.warframe.com/promocode?code=MemeSage]]

local ExportFlavour_en = require"json".decode(io.contents("../../warframe-public-export/ExportFlavour_en.json")).ExportFlavour
local function find_glyph_for_code(code)
	for ExportFlavour_en as glyph do
		if code in glyph.uniqueName:upper()
			or glyph.name:upper():startswith(code)
		then
			return glyph.uniqueName
		end
	end
	print("Glyph not found for code: " .. code)
end
local output = {}
for input:split("\n") as line do
	local code = line:replace("https://www.warframe.com/promocode?code=", "")
	if key := find_glyph_for_code(code) then
		output[key] = { promo_code = code }
	end
end
print(require"json".encode(output, true))
